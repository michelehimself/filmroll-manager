{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FilmRoll Manager",
  "version": "0.7.0",
  "identifier": "com.michelehimself.filmrollmanager",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FilmRoll Manager",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyM0IxNUVGNDRGREExQkYKUldTL29mMUU3eFU3d2xHVnMvT2t4aGhmRHl3K0U4M000OTF6RTFDVzNiUjl5S05OSU5LalZwWksK",
      "endpoints": [
        "https://github.com/michelehimself/filmroll-manager/releases/latest/download/latest.json"
      ]
    }
  }
}
